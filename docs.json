    "metatags": {
      "robots": "noindex, nofollow"
    }
  },
  "markdown": {
    "instructions": [
      "These Mintlify docs are retired. The canonical developer home is https://scopable.io/docs.",
      "The Scopable product MCP server is https://mcp.scopable.io/mcp. Read https://scopable.io/mcp and https://scopable.io/docs/scopable-mcp-guide. Do not use the hosted Scopable Docs MCP on this Mintlify domain.",
      "The REST API index is https://scopable.io/developers, the endpoint reference is https://scopable.io/api, and the OpenAPI document is https://scopable.io/openapi.json.",
      "Support is support@scopable.io."
    ]
  },
